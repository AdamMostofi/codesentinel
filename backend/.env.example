# ============================================
# CodeSentinel Environment Configuration
# ============================================
# To get started:
#   1. Copy this file to .env:  cp .env.example .env
#   2. Edit .env with your settings
#   3. Run: docker-compose up --build
# ============================================

# --- REQUIRED: Groq API Key ---
# Get a free API key at: https://console.groq.com/keys
# This enables AI-powered remediation with old/new code comparison.
GROQ_API_KEY=your_groq_api_key_here

# --- OPTIONAL: Groq Model ---
# Default: llama-3.3-70b-versatile
# Currently available free models (check https://console.groq.com/docs/models for the latest):
#   - llama-3.3-70b-versatile (recommended)
#   - llama-3.1-8b-instant
#   - mixtral-8x7b-32768
# To change the model, just update this variable and restart the containers.
GROQ_MODEL=llama-3.3-70b-versatile
